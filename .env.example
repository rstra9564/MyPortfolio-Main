# Copy to .env and fill in from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# GitHub Pages base path — leave as / for local dev.
# Production builds default to /MyPortfolio-Main/; CI sets this from the repo name.
VITE_BASE_PATH=/
